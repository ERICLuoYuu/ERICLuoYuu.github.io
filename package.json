{
  "name": "parcel-site",
  "version": "1.0.0",
  "private": true,
  "description": "A hand-made parcel personal website: cut the tape, look inside, read the little book.",
  "type": "module",
  "scripts": {
    "serve": "node tools/serve.mjs",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/unit/*.test.js\"",
    "test:py": "python -m pytest tools/tests -q",
    "test:e2e": "playwright test",
    "test:live": "node -e \"process.env.BASE_URL=process.env.BASE_URL||'https://ericluoyuu.github.io/'; require('child_process').execSync('npx playwright test',{stdio:'inherit',env:process.env})\"",
    "assets:placeholders": "python tools/generate_placeholders.py",
    "clothes": "python tools/generate_clothes.py && node tools/build-pile.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
